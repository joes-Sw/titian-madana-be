# Database. Default SQLite untuk development cepat.
# Untuk PostgreSQL: postgresql+psycopg2://user:pass@localhost:5432/spse
DATABASE_URL=sqlite:///./spse.db

# Sumber SPSE (jangan diubah kecuali pindah instansi)
BASE_URL=https://spse.inaproc.id/lkpp

# Tahun anggaran yang di-scrape
TAHUN=2026

# Jeda antar request (detik) supaya tidak membebani server
REQUEST_DELAY=1.5
PAGE_SIZE=100
MAX_RETRIES=3

# Scope scraping
SCRAPE_TENDER=true
SCRAPE_NONTENDER=true
SCRAPE_DETAIL=true

# Auto-grab
SCHEDULER_ENABLED=true
SCRAPE_INTERVAL_HOURS=6

LOG_LEVEL=INFO
